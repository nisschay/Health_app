# Frontend - copy these to web/.env.local
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:abc123
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DIRECT_API_URL=http://127.0.0.1:8000

# Backend
DATABASE_URL=postgresql://user:password@host:5432/dbname
Google_API_KEY=sk-ant-your_key_here
GEMINI_API_KEY=your_gemini_key_here
# Comma-separated fallback order. gemini-2.5-flash retires 16 Oct 2026.
GEMINI_EXTRACTION_MODELS=gemini-3.8-flash
GEMINI_CHAT_MODELS=gemini-3.8-flash
# Free-tier requests per minute; outgoing calls are paced to this.
GEMINI_RPM=10
# Parallel PDF extractions per upload, and uploads analysed at once.
EXTRACTION_WORKERS=4
JOB_WORKERS=2
# Seconds before a model call is abandoned.
CHAT_MODEL_TIMEOUT_SECONDS=50
EXTRACTION_MODEL_TIMEOUT_SECONDS=120
API_CORS_ORIGINS=http://localhost:3000
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CREDENTIALS_PATH=/absolute/path/to/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_CLOCK_SKEW_SECONDS=60

# Upload and rate limits (defaults shown)
MAX_UPLOAD_FILES=20
MAX_UPLOAD_FILE_MB=10
MAX_UPLOAD_TOTAL_MB=25
RATE_LIMIT_PER_MINUTE=20
